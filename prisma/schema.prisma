// Persistence without accounts (Phase 32).
//
// A partida is a row and its state is the JSON the engine already is —
// decision 5 (the rng rides as one number) makes the whole RondaState
// serializable, so the engine neither knows nor cares where a state slept.
//
// SQLite everywhere: a local file in dev, Turso (libSQL) in production,
// through the driver adapter in lib/server/db.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Partida {
  id        String   @id @default(cuid())
  /// The short invite code (Phase 33). Unique among live partidas.
  codigo    String   @unique
  /// Which game this partida is (Phase 78): 'carioca' | 'mentiroso'. Every
  /// row that predates the choice is Carioca, which is what the default says.
  juego     String   @default("carioca")
  /// 'lobby' | 'jugando' | 'terminada'
  fase      String   @default("lobby")
  /// JSON PartidaConfig — contracts, comodines, bonus, opener.
  config    String
  /// JSON PartidaState once dealt; null while the lobby is still filling.
  estado    String?
  /// JSON Relato[] — everything public that has happened this ronda, in
  /// order. Cleared when a new reparto starts, like the table's own log.
  relatos   String  @default("[]")
  /// When the turn in play began. Bot turns are advanced lazily against it:
  /// a serverless function has no clock between requests, so the deadline is
  /// stored and the next request applies whatever has come due.
  turnoDesde DateTime?
  /// Seconds per human turn (Phase 36). The host's to change in the lobby.
  segundosPorTurno Int @default(45)
  /// Seconds a bot thinks per turn.
  segundosBot      Int @default(2)
  /// El Mentiroso's window to call (Phase 78): seconds after each play in
  /// which anyone may call and nobody may play. Pacing, like the two above.
  segundosVentana  Int @default(3)
  /// Memory aids (Phase 24), a table rule rather than a personal comfort:
  /// may the descarte be browsed, and may the ronda's story be reread.
  verDescarte  Boolean @default(true)
  verHistorial Boolean @default(true)
  /// JSON string[] — the comodín gallery as it was when this partida was
  /// created (Phase 71). Faces are dealt from this copy, so editing the
  /// gallery never changes a partida in progress. Null for partidas older
  /// than the copy, which deal from the gallery as it is now.
  caras        String?
  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt
  asientos      Asiento[]
}

model Asiento {
  id        String  @id @default(cuid())
  partidaId String
  partida   Partida @relation(fields: [partidaId], references: [id], onDelete: Cascade)
  /// Seat index at the table, 0-based.
  indice    Int
  alias     String
  /// The per-browser secret that owns this seat. Null for a bot.
  secreto   String?
  esBot     Boolean @default(false)
  /// Which bot sits here, by its id in `lib/bots/catalogo.ts` (Phase 39).
  /// Null for a person, and null for a bot seated before there was a choice —
  /// `botPorId` reads either as El Codicioso, so an old partida still plays.
  bot       String?
  /// True for the seat that created the partida and runs its lobby.
  esHost    Boolean @default(false)
  /// Retired on purpose (Abandonar, Phase 37): plays no more turns.
  retirado  Boolean @default(false)
  /// Last time this seat's browser was heard from (presence, Phase 37).
  ultimaSenal DateTime?

  @@unique([partidaId, indice])
  @@index([secreto])
}

/// One face in the comodín gallery (Phase 71). The image lives in Vercel
/// Blob; this row is what makes it part of the gallery.
model Comodin {
  id       String   @id @default(cuid())
  /// The public Blob URL — what a card and the gallery load.
  url      String   @unique
  /// The Blob pathname, for deleting it.
  pathname String
  /// The name it was uploaded with, for the editing screen.
  nombre   String
  creadoEn DateTime @default(now())
}
